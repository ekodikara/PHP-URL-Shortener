# Snip — environment template. Copy to .env and fill in real values.
#   cp .env.example .env && edit .env
# .env is git-ignored; never commit real secrets. Rotate anything that leaks.

# --- Database (REQUIRED in prod; use long random values, not these) ----------
DB_HOST=db
DB_NAME=shortener
DB_USER=shortener
DB_PASSWORD=change-me-strong-db-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# --- Public URL / proxy ------------------------------------------------------
# SITE_DOMAIN: bare apex/host Caddy serves (prod compose). e.g. jmpz.cc
SITE_DOMAIN=jmpz.cc
# SITE_HOST: trusted public base URL WITH trailing slash. e.g. https://jmpz.cc/
SITE_HOST=https://jmpz.cc/
# TRUSTED_PROXIES: empty=REMOTE_ADDR only; 'private'=trust XFF from private net
# (correct behind Caddy/ALB); or a comma list of exact proxy IPs.
TRUSTED_PROXIES=private

# --- Stripe (REQUIRED for billing) -------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# From `stripe listen` locally, or the Dashboard webhook endpoint in prod.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Bot / abuse protection --------------------------------------------------
# reCAPTCHA v2: set real keys in prod. Empty = adaptive gate FAILS CLOSED
# (blocks suspicious clients rather than waving them through).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
# Cloudflare Turnstile (optional; layered on register/login when both set).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# IPQualityScore (optional): enables VPN/proxy/Tor detection AND (for the content
# filter below) adult/URL-category lookups on destination URLs.
IPQS_API_KEY=

# --- Content filtering (adult / malicious destinations) ----------------------
# Google Safe Browsing v4 key — destination URLs are checked at creation and
# (cached) at redirect. EMPTY = malware/phishing checks DISABLED. Free key from
# Google Cloud (enable the Safe Browsing API). Recommended for a public launch.
SAFE_BROWSING_API_KEY=
# Adult/AUP layers on top of Safe Browsing: a bundled adult-domain blocklist +
# an admin-managed blocklist + (when IPQS_API_KEY is set) IPQS URL-category
# checks. Set to 0 to disable the adult layers only; Safe Browsing still applies.
CONTENT_FILTER_ON=1
# Override the bundled blocklist path (blank = shipped data/adult-domains.txt).
ADULT_BLOCKLIST=

# --- Analytics geo (optional) ------------------------------------------------
# IP->country DB for click analytics (.mmdb; GeoLite2-Country or DB-IP Lite).
# Fetch with scripts/update-geoip.sh BEFORE `docker compose build` — it's
# gitignored and baked into the image if present. Blank/absent = "Unknown".
GEOIP_DB=

# --- Registration anti-bot ---------------------------------------------------
# Require a verified email before a user can create NEW links (1=on). If mail is
# not actually delivering in prod, this dead-ends signups — see mail below.
REQUIRE_EMAIL_VERIFICATION=1
# Reject disposable/temporary email providers at sign-up (1=on).
BLOCK_DISPOSABLE_EMAIL=1

# --- Outbound mail (email verification + password reset) ---------------------
# Empty MAIL_FROM = dev mode: emails are written to cache/mail.log instead of
# being sent. In PROD set a from-address AND point PHP mail() at a real SMTP
# relay (SES/Postmark/Resend — the base image has no MTA) with SPF/DKIM/DMARC on
# your domain, or verification emails won't arrive and signups dead-end.
MAIL_FROM=
MAIL_REPLY_TO=
# Address shown on /report and /terms (default: abuse@<host> if blank).
ABUSE_EMAIL=

# --- Admin -------------------------------------------------------------------
# Comma-separated emails granted /admin (in addition to the users.is_admin flag).
ADMIN_EMAILS=

# --- Enterprise SSO (optional; active only when configured) ------------------
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_JWKS_URL=
SAML_IDP_ENTITY_ID=
SAML_IDP_SSO_URL=
SAML_IDP_CERT=
SSO_ALLOWED_DOMAINS=
SSO_DEFAULT_PLAN=enterprise

# --- Sessions ----------------------------------------------------------------
# 'files' (default, single instance) or 'db' (shared MySQL-backed sessions,
# required when running more than one web instance behind a load balancer).
# 'db' needs migration 003 applied (scripts/migrate.php).
SESSION_DRIVER=files

# --- Retention ---------------------------------------------------------------
# Days to keep access_log / security_log / stripe_events before prune.php drops
# them (also caps how long visitor IPs are retained). Default 90.
LOG_RETENTION_DAYS=90

# --- Backups (backup.sh) -----------------------------------------------------
S3_BUCKET=
RETAIN_DAYS=30
# Optional: recipient of a failure alert, and a GPG recipient/key to encrypt dumps.
BACKUP_ALERT_URL=
BACKUP_GPG_RECIPIENT=
